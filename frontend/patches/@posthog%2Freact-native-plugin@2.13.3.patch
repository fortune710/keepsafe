+// Native crash events never pass through the JavaScript privacy filter.
+private fun keepsafeNativeCrash(event: PostHogEvent): PostHogEvent {
+  if (event.event != "\$exception") return event
+  val old = event.properties ?: return event
+  val jsProperties = jsFatalCaptureProperties.get()
+  if (jsProperties != null) {
+    old.clear()
+    old.putAll(jsProperties)
+    return event
+  }
+  fun address(value: Any?): String? = (value as? String)?.takeIf { it.matches(Regex("0x[0-9a-fA-F]{1,16}")) }
+  val exceptions = (old["\$exception_list"] as? List<*>)?.take(20)?.mapNotNull { raw ->
+    val entry = raw as? Map<*, *> ?: return@mapNotNull null
+    val item = mutableMapOf<String, Any>("type" to "NativeCrash", "value" to "Native crash (details redacted)", "mechanism" to mapOf("type" to "generic", "handled" to false))
+    val stack = entry["stacktrace"] as? Map<*, *>
+    val frames = stack?.get("frames") as? List<*>
+    if (frames != null) {
+      item["stacktrace"] = mapOf("type" to "raw", "frames" to frames.take(200).mapNotNull { rawFrame ->
+        val frame = rawFrame as? Map<*, *> ?: return@mapNotNull null
+        val safe = mutableMapOf<String, Any>("platform" to "android")
+        for (key in listOf("instruction_addr", "image_addr")) address(frame[key])?.let { safe[key] = it }
+        (frame["in_app"] as? Boolean)?.let { safe["in_app"] = it }
+        safe
+      })
+    }
+    item
+  } ?: emptyList()
+  val processPerson = old["\$process_person_profile"] as? Boolean
+  val session = old["\$session_id"] as? String
+  val versions = listOf("\$os_version", "\$app_version", "\$app_build").mapNotNull { key ->
+    (old[key] as? String)?.takeIf { it.matches(Regex("[0-9]{1,6}(\\.[0-9]{1,6}){0,3}")) }?.let { key to it }
+  }
+  old.clear()
+  versions.forEach { (key, value) -> old[key] = value }
+  old["\$exception_list"] = exceptions
+  old["\$exception_source"] = "android.crash_reporter"
+  old["\$os_name"] = "Android"
+  if (processPerson != null) old["\$process_person_profile"] = processPerson
+  old["\$ip"] = "0.0.0.0"
+  if (session != null && runCatching { java.util.UUID.fromString(session) }.isSuccess) old["\$session_id"] = session
+  return event
+}
