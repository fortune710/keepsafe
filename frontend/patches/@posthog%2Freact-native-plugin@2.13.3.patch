+// Queued records from older SDKs bypass beforeSend. Quarantine them before
+// setup starts the native queues, keeping the files on device for recovery.
+private let keepsafeMigrationLock = NSLock()
+private func keepsafePrepareNativeStorage(projectToken: String) -> Bool {
+    guard !projectToken.isEmpty,
+          projectToken.range(of: "^[A-Za-z0-9_-]+$", options: .regularExpression) != nil,
+          let bundle = Bundle.main.bundleIdentifier,
+          let support = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else { return false }
+    keepsafeMigrationLock.lock()
+    defer { keepsafeMigrationLock.unlock() }
+    let base = support.appendingPathComponent(bundle, isDirectory: true)
+    let project = base.appendingPathComponent(projectToken, isDirectory: true)
+    let marker = project.appendingPathComponent("keepsafe.native-privacy-v1")
+    let manager = FileManager.default
+    if manager.fileExists(atPath: marker.path) { return true }
+    let queues = ["posthog.queueFolder.uuid", "posthog.queueFolder", "posthog.queue.plist", "posthog.replayFolder.uuid", "posthog.replayFolder", "posthog.replayBufferFolder", "posthog.logsFolder"]
+    do {
+        let quarantine = project.appendingPathComponent("keepsafe.unfiltered-native-queues", isDirectory: true)
+        try manager.createDirectory(at: quarantine, withIntermediateDirectories: true)
+        for folder in [base, project] {
+            for name in queues {
+                let source = folder.appendingPathComponent(name)
+                if !manager.fileExists(atPath: source.path) { continue }
+                let destination = quarantine.appendingPathComponent(UUID().uuidString + "-" + name)
+                try manager.moveItem(at: source, to: destination)
+            }
+        }
+        try Data("1".utf8).write(to: marker, options: .atomic)
+        return true
+    } catch {
+        // Never print paths or start analytics when migration has failed.
+        return false
+    }
+}
