+// Native crashes bypass the JavaScript before_send hook. Keep only structured,
+// non-user-controlled crash data, including the addresses needed for symbolication.
+private func keepsafeNativeCrash(_ event: PostHogEvent) -> PostHogEvent {
+    guard event.event == "$exception" else { return event }
+    func address(_ value: Any?) -> String? {
+        guard let value = value as? String, value.range(of: "^0x[0-9a-fA-F]{1,16}$", options: .regularExpression) != nil else { return nil }
+        return value
+    }
+    let old = event.properties
+    let exceptions = (old["$exception_list"] as? [[String: Any]] ?? []).prefix(20).map { entry -> [String: Any] in
+        var item: [String: Any] = ["type": "NativeCrash", "value": "Native crash (details redacted)"]
+        if let stack = entry["stacktrace"] as? [String: Any], let frames = stack["frames"] as? [[String: Any]] {
+            item["stacktrace"] = ["type": "raw", "frames": frames.prefix(200).map { frame -> [String: Any] in
+                var safe: [String: Any] = ["platform": "apple"]
+                for key in ["instruction_addr", "image_addr"] { if let value = address(frame[key]) { safe[key] = value } }
+                if let inApp = frame["in_app"] as? Bool { safe["in_app"] = inApp }
+                return safe
+            }]
+        }
+        item["mechanism"] = ["type": "generic", "handled": false]
+        return item
+    }
+    var safe: [String: Any] = ["$exception_list": exceptions, "$exception_source": "ios.crash_reporter", "$os_name": "iOS", "$ip": "0.0.0.0"]
+    for key in ["$os_version", "$app_version", "$app_build"] {
+        if let value = old[key] as? String, value.range(of: "^[0-9]{1,6}(\\.[0-9]{1,6}){0,3}$", options: .regularExpression) != nil { safe[key] = value }
+    }
+    if let processPerson = old["$process_person_profile"] as? Bool { safe["$process_person_profile"] = processPerson }
+    if let session = old["$session_id"] as? String, UUID(uuidString: session) != nil { safe["$session_id"] = session }
+    if let images = old["$debug_images"] as? [[String: Any]] {
+        safe["$debug_images"] = images.prefix(500).compactMap { image -> [String: Any]? in
+            guard let id = image["debug_id"] as? String, UUID(uuidString: id) != nil,
+                  let base = address(image["image_addr"]) else { return nil }
+            var result: [String: Any] = ["debug_id": id, "image_addr": base, "type": "macho"]
+            if let size = image["image_size"] as? NSNumber { result["image_size"] = size }
+            if let arch = image["arch"] as? String, ["arm64", "arm64e", "x86_64"].contains(arch) { result["arch"] = arch }
+            return result
+        }
+    }
+    event.properties = safe
+    return event
+}
