# Local template for the VPS production stack. Never commit populated values.
# GitHub Actions renders .env.production from production Environment secrets.
SUPABASE_URL=https://your-keepsafe-project.supabase.co
SUPABASE_KEY=replace-with-keepsafe-service-role-key
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-keepsafe-key
PINECONE_API_KEY=replace-with-keepsafe-key
PINECONE_INDEX_NAME=keepsafe-entries
PINECONE_ENVIRONMENT=
REDIS_PASSWORD=replace-with-unique-keepsafe-password
SENDGRID_API_KEY=replace-with-keepsafe-key
SENDGRID_FROM_EMAIL=contact@fortunealebiosu.dev
SENDGRID_FROM_NAME=Keepsafe
ENTRY_REPORT_NOTIFICATION_TO_EMAIL=replace-with-notification-recipient
SUPABASE_WEBHOOK_SECRET=replace-with-keepsafe-signing-secret

# Optional integrations. Set only when the corresponding feature is enabled.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Runner-only migration secret, not written to .env.production:
SUPABASE_DB_URL=postgresql://replace-with-production-db-connection
# Mobile release configuration, not consumed by the VPS Compose stack:
# EXPO_PUBLIC_BACKEND_URL=https://keepsafeapi.fortunealebiosu.dev
# EXPO_PUBLIC_SUPABASE_URL=https://your-keepsafe-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-keepsafe-anon-key
